<odoo><data noupdate="1">
 <record id="rule_patient_staff_org" model="ir.rule"><field name="name">MediBook patients organization scope</field><field name="model_id" ref="model_medibook_patient"/><field name="domain_force">[('organization_id','=',user.medibook_organization_id.id)]</field><field name="groups" eval="[(4,ref('medibook_base.group_medibook_receptionist'))]"/></record>
 <record id="rule_patient_self" model="ir.rule"><field name="name">MediBook patient self</field><field name="model_id" ref="model_medibook_patient"/><field name="domain_force">[('user_id','=',user.id)]</field><field name="groups" eval="[(4,ref('medibook_base.group_medibook_patient'))]"/></record>
 <record id="rule_medical_record_doctor" model="ir.rule"><field name="name">MediBook clinical records doctor scope</field><field name="model_id" ref="model_medibook_medical_record"/><field name="domain_force">[('patient_id.appointment_ids.doctor_id.user_id','=',user.id)]</field><field name="groups" eval="[(4,ref('medibook_base.group_medibook_doctor'))]"/></record>
 <record id="rule_medical_record_patient" model="ir.rule"><field name="name">MediBook clinical records patient scope</field><field name="model_id" ref="model_medibook_medical_record"/><field name="domain_force">[('patient_id.user_id','=',user.id)]</field><field name="groups" eval="[(4,ref('medibook_base.group_medibook_patient'))]"/></record>
</data></odoo>