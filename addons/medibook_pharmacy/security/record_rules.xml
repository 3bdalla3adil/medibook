<odoo><data noupdate="1">
<record id="rule_pharmacy_portal_deny" model="ir.rule"><field name="name">Pharmacy portal deny</field><field name="model_id" ref="model_medibook_pharmacy"/><field name="domain_force">[(0,'=',1)]</field><field name="groups" eval="[(4,ref('base.group_portal'))]"/></record>
<record id="rule_pharmacy_own_org" model="ir.rule"><field name="name">Pharmacist own pharmacy</field><field name="model_id" ref="model_medibook_pharmacy"/><field name="domain_force">[('organization_id','=',user.medibook_organization_id.id),('pharmacist_ids','in',[user.id])]</field><field name="groups" eval="[(4,ref('medibook_base.group_medibook_pharmacist'))]"/></record>
<record id="rule_dispense_portal_deny" model="ir.rule"><field name="name">Dispense portal deny</field><field name="model_id" ref="model_medibook_dispense_record"/><field name="domain_force">[(0,'=',1)]</field><field name="groups" eval="[(4,ref('base.group_portal'))]"/></record>
<record id="rule_dispense_pharmacist_own" model="ir.rule"><field name="name">Dispense pharmacist own pharmacy</field><field name="model_id" ref="model_medibook_dispense_record"/><field name="domain_force">[('pharmacy_id.pharmacist_ids','in',[user.id])]</field><field name="groups" eval="[(4,ref('medibook_base.group_medibook_pharmacist'))]"/></record>
</data></odoo>
