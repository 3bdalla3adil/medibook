<odoo>
    <record id="group_medibook_patient" model="res.groups">
        <field name="name">MediBook / Patient</field>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
        <field name="comment">Portal user. Can see own appointments and records.</field>
    </record>
    <record id="group_medibook_portal_doctor" model="res.groups">
        <field name="name">MediBook / Portal Doctor</field>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
        <field name="comment">Doctor using the Flutter app only. No backend access.</field>
    </record>
    <record id="group_medibook_doctor" model="res.groups">
        <field name="name">MediBook / Doctor</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_medibook_receptionist" model="res.groups">
        <field name="name">MediBook / Receptionist</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_medibook_clinic_admin" model="res.groups">
        <field name="name">MediBook / Clinic Admin</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('medibook_base.group_medibook_receptionist'))]"/>
    </record>
    <record id="group_medibook_org_admin" model="res.groups">
        <field name="name">MediBook / Organization Admin</field>
        <field name="implied_ids" eval="[(4, ref('medibook_base.group_medibook_clinic_admin'))]"/>
    </record>
    <record id="group_medibook_super_admin" model="res.groups">
        <field name="name">MediBook / Super Admin</field>
        <field name="implied_ids" eval="[(4, ref('medibook_base.group_medibook_org_admin'))]"/>
    </record>
</odoo>
