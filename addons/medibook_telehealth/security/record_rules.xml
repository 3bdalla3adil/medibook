<odoo><data noupdate="1">
<record id="rule_telehealth_session_portal_deny" model="ir.rule"><field name="name">Telehealth portal deny</field><field name="model_id" ref="model_medibook_telehealth_session"/><field name="domain_force">[(0,'=',1)]</field><field name="groups" eval="[(4,ref('base.group_portal'))]"/></record>
<record id="rule_telehealth_session_participant" model="ir.rule"><field name="name">Telehealth participants only</field><field name="model_id" ref="model_medibook_telehealth_session"/><field name="domain_force">['|',('host_user_id','=',user.id),('guest_user_id','=',user.id)]</field><field name="groups" eval="[(4,ref('medibook_base.group_medibook_patient')),(4,ref('medibook_base.group_medibook_doctor'))]"/></record>
<record id="rule_telehealth_signal_portal_deny" model="ir.rule"><field name="name">Telehealth signal portal deny</field><field name="model_id" ref="model_medibook_telehealth_signal"/><field name="domain_force">[(0,'=',1)]</field><field name="groups" eval="[(4,ref('base.group_portal'))]"/></record>
</data></odoo>
